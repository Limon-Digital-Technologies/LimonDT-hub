{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limon Digital Tech. Hub",
  "version": "0.2.0",
  "identifier": "tech.limon.digital.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Limon Digital Tech. Hub",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/Limon-Digital-Technologies/LimonDT-hub/releases/latest/download/latest.json"
      ]
    }
  }
}
